GROQ_API_KEY=your_groq_api_key_here
TENANT_CONFIG_PATH=configs/demo_hospital.yaml
GROQ_MODEL=openai/gpt-oss-20b
# Optional n8n production webhook; receives booking details when a request is complete.
# N8N_BOOKING_WEBHOOK_URL=https://your-n8n-host/webhook/your-webhook-id
# Optional shared bearer token, if the n8n webhook requires authentication.
# N8N_WEBHOOK_TOKEN=replace-with-a-long-random-token
# Set this from your authentication layer in a multi-user deployment.
# GROQFLOW_USER_ID=your-stable-user-id

# Optional overrides
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=1024
# RETRIEVAL_K=4
# VECTOR_DB_PATH=vector_db
# UPLOADED_DOCUMENTS_PATH=uploaded_documents
